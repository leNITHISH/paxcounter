// Copy this file to secrets.h (gitignored) and replace with your own secret.
// Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
//
// PAX_PEPPER keys the HMAC used to hash captured MAC addresses. It protects
// against someone who gets only the CSV output (not radio access) brute-
// forcing real MACs back out of the hashes -- it does NOT protect against
// physical/firmware access to this device, and does NOT hide MACs from
// anyone capturing the probe requests themselves (802.11 management frames
// are unencrypted, the real MAC is already in the clear over the air).
#define PAX_PEPPER "replace-this-with-your-own-generated-secret"
